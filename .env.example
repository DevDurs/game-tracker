# Free key from https://pandascore.co/ (sign up, no credit card needed)
PANDASCORE_API_KEY=

# How often the server polls for new match data (seconds)
REFRESH_INTERVAL_SECONDS=30

# Set to true to force all games to use sample/demo data (no API key needed)
DEMO_MODE=false

PORT=9012

# Single login for the /admin panel (change refresh rate, disable games,
# add new ones). Required — the admin panel refuses to work without both set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
